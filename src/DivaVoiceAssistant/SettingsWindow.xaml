<Window x:Class="DivaVoiceAssistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Diva 设置"
        Width="500" Height="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        Background="#F5F7FB">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,16,20,20">

            <TextBlock Text="API 配置" FontWeight="Bold" FontSize="14" Foreground="#3B6FF5" />
            <TextBlock Text="API 密钥（也可用环境变量 DIVA_API_KEY 覆盖）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
            <PasswordBox x:Name="ApiKeyBox" />
            <TextBlock Text="API 地址" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
            <TextBox x:Name="ApiHostBox" />
            <TextBlock Text="语音识别模型" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
            <TextBox x:Name="SpeechModelBox" />
            <TextBlock Text="DSH 指令模型" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
            <TextBox x:Name="DSHModelBox" />
            <TextBlock Text="唤醒词" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
            <TextBox x:Name="WakeWordBox" />
            <TextBlock Text="搜索引擎" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
            <ComboBox x:Name="SearchEngineBox" />
            <TextBlock Text="麦克风设备" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
            <ComboBox x:Name="MicBox" />

            <TextBlock Text="语音检测" FontWeight="Bold" FontSize="14" Foreground="#3B6FF5" Margin="0,16,0,0" />
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="VAD 阈值" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <TextBlock x:Name="VadValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <Slider x:Name="VadSlider" Minimum="0.005" Maximum="0.1" TickFrequency="0.005" IsSnapToTickEnabled="True"
                        ValueChanged="VadSlider_OnValueChanged" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="静音结束判定" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <TextBlock x:Name="SilenceValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <Slider x:Name="SilenceSlider" Minimum="300" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"
                        ValueChanged="SilenceSlider_OnValueChanged" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="最长指令时长" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <TextBlock x:Name="MaxUtteranceValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <Slider x:Name="MaxUtteranceSlider" Minimum="3000" Maximum="30000" TickFrequency="1000" IsSnapToTickEnabled="True"
                        ValueChanged="MaxUtteranceSlider_OnValueChanged" />
            </DockPanel>

            <TextBlock Text="语音播报" FontWeight="Bold" FontSize="14" Foreground="#3B6FF5" Margin="0,16,0,0" />
            <TextBlock Text="播报方式" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
            <ComboBox x:Name="TtsModeBox" />
            <TextBlock Text="云端音色（qwen3-tts-flash：Cherry / Serena / Ethan / Noah 等）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
            <TextBox x:Name="TtsVoiceBox" />
            <TextBlock Text="本地语速（仅本地模式）" Margin="0,10,0,0" FontSize="12" Foreground="#55606F" />
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="语速" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <TextBlock x:Name="TtsRateValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <Slider x:Name="TtsRateSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                        ValueChanged="TtsRateSlider_OnValueChanged" />
            </DockPanel>
            <DockPanel Margin="0,8,0,0">
                <TextBlock DockPanel.Dock="Left" Text="音量" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <TextBlock x:Name="TtsVolumeValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <Slider x:Name="TtsVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="TtsVolumeSlider_OnValueChanged" />
            </DockPanel>

            <TextBlock Text="行为选项" FontWeight="Bold" FontSize="14" Foreground="#3B6FF5" Margin="0,16,0,0" />
            <TextBlock Text="唤醒方式" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
            <ComboBox x:Name="WakeModeBox" />
            <CheckBox x:Name="HotKeyCheck" Content="启用全局快捷键 Ctrl+Alt+D 唤醒" Margin="0,8,0,0" FontSize="12" />
            <CheckBox x:Name="TrayCheck" Content="点击关闭时最小化到系统托盘" Margin="0,6,0,0" FontSize="12" />
            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Margin="0,6,0,0" FontSize="12" />
            <DockPanel Margin="0,10,0,0">
                <TextBlock DockPanel.Dock="Left" Text="连续对话超时" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <TextBlock x:Name="ConvTimeoutValue" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                <Slider x:Name="ConvTimeoutSlider" Minimum="0" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                        ValueChanged="ConvTimeoutSlider_OnValueChanged" />
            </DockPanel>
            <TextBlock Text="（连续对话：指令后保持倾听无需再次呼叫，可随时插嘴；沉默超时后自动待命，0=关闭）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
            <TextBlock Text="应用别名（每行：名称=路径或链接，用于找不到程序时兜底，如 战神5=steam://rungameid/2322010）" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
            <TextBox x:Name="AliasesBox" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
            <DockPanel Margin="0,10,0,0">
                <Button Content="重新扫描已装软件" Width="140" HorizontalAlignment="Left" Click="RescanSoftwareButton_OnClick" />
                <TextBlock x:Name="InventoryInfo" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="#7A8699" TextWrapping="Wrap" />
            </DockPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="取消" Width="90" Margin="0,0,10,0" Click="CancelButton_OnClick" />
                <Button Content="保存" Width="90" Background="#3B6FF5" Foreground="White" Click="SaveButton_OnClick" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Window>
