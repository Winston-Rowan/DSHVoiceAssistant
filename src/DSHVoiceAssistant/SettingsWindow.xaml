<Window x:Class="DSHVoiceAssistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DSH 设置"
        Width="560" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI"
        Background="#F5F7FB">
    <DockPanel Margin="0,0,0,0">
        <!-- 底部按钮栏：先声明 → 占满底部整行；TabControl 最后声明 → 自动填充剩余空间 -->
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,14">
            <TextBlock x:Name="ApplyStatus" HorizontalAlignment="Center" FontSize="11" Foreground="#2E9E5B" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="取消" Width="90" Margin="0,0,10,0" Click="CancelButton_OnClick" />
                <Button Content="应用" Width="90" Margin="0,0,10,0" Click="ApplyButton_OnClick" />
                <Button Content="保存" Width="90" Background="#3B6FF5" Foreground="White" Click="SaveButton_OnClick" />
            </StackPanel>
        </StackPanel>

        <TabControl x:Name="SettingsTabs" Margin="12,10,12,0" Padding="8">
            <!-- ============ API 配置 ============ -->
            <TabItem Header="API 配置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <TextBlock Text="百炼 API（语音识别 / 语音合成）" FontWeight="Bold" FontSize="13" Foreground="#55606F" />
                        <TextBlock Text="API 密钥（也可用环境变量 DSH_API_KEY 覆盖）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
                        <PasswordBox x:Name="ApiKeyBox" />
                        <TextBlock Text="API 地址" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <TextBox x:Name="ApiHostBox" />
                        <TextBlock Text="语音识别模型" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <TextBox x:Name="SpeechModelBox" />

                        <TextBlock Text="DSH API（指令引擎，DeepSeek 官方）" FontWeight="Bold" FontSize="13" Foreground="#55606F" Margin="0,16,0,0" />
                        <TextBlock Text="DSH API 密钥（留空则回退使用百炼密钥；也可用环境变量 DEEPSEEK_API_KEY）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
                        <PasswordBox x:Name="DshApiKeyBox" />
                        <TextBlock Text="DSH API 地址" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <TextBox x:Name="DshApiHostBox" />
                        <TextBlock Text="DSH 指令模型" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="DSHModelBox" />

                        <TextBlock Text="其他" FontWeight="Bold" FontSize="13" Foreground="#55606F" Margin="0,16,0,0" />
                        <TextBlock Text="搜索引擎（DSH 执行网络搜索时使用）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="SearchEngineBox" />
                        <TextBlock Text="权限模式（DSH 执行权限，与 DSH 三种模式一致）" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="PermissionModeBox" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 唤醒与对话 ============ -->
            <TabItem Header="唤醒与对话">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <TextBlock Text="唤醒词" Margin="0,0,0,2" FontSize="12" Foreground="#7A8699" />
                        <TextBox x:Name="WakeWordBox" />
                        <TextBlock Text="唤醒词变体（逗号分隔，识别命中任一即唤醒；留空自动按主词生成）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
                        <TextBox x:Name="WakeVariantsBox" FontSize="12" />
                        <TextBlock Text="助手名称（DSH 身份，问“你叫什么名字”时回答；留空用唤醒词）" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
                        <TextBox x:Name="NameBox" FontSize="12" />
                        <TextBlock Text="唤醒方式" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="WakeModeBox" />
                        <CheckBox x:Name="HotKeyCheck" Content="启用全局快捷键（唤醒/倾听）" Margin="0,10,0,0" FontSize="12" />
                        <DockPanel Margin="24,6,0,0">
                            <Button x:Name="HotKeyCaptureButton" Content="点击后按下新组合键…" Width="160" HorizontalAlignment="Left" Click="HotKeyCaptureButton_OnClick" />
                            <TextBlock x:Name="HotKeyDisplay" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" FontWeight="Bold" Foreground="#22303F" />
                        </DockPanel>
                        <TextBlock Text="（修改保存后立即生效；至少需要一个修饰键，Esc 取消捕获）" Margin="24,2,0,0" FontSize="11" Foreground="#9AA5B1" />
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="连续对话超时" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="ConvTimeoutValue" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="ConvTimeoutSlider" Minimum="0" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="ConvTimeoutSlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="（连续对话：指令后保持倾听无需再次呼叫；沉默超时后自动待命，0=关闭）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="多轮记忆轮数" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="HistoryValue" DockPanel.Dock="Right" Width="60" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="HistorySlider" Minimum="0" Maximum="20" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="HistorySlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="（DSH 携带最近 N 轮对话作为上下文，0=单轮不记忆）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 麦克风与检测 ============ -->
            <TabItem Header="麦克风与检测">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <TextBlock Text="麦克风设备" Margin="0,0,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="MicBox" />
                        <DockPanel Margin="0,12,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="麦克风增益" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="MicGainValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="MicGainSlider" Minimum="1" Maximum="8" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    ValueChanged="MicGainSlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="（低增益麦克风适配，采集源头统一放大，1.0=不增益；保存后重启生效）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="VAD 阈值" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="VadValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="VadSlider" Minimum="0.005" Maximum="0.1" TickFrequency="0.005" IsSnapToTickEnabled="True"
                                    ValueChanged="VadSlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="（说话判定灵敏度，越小越灵敏；系统会按环境噪声自动兜底）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="静音结束判定" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="SilenceValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="SilenceSlider" Minimum="300" Maximum="3000" TickFrequency="100" IsSnapToTickEnabled="True"
                                    ValueChanged="SilenceSlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="（一句话结束后静音多久判定说完）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                        <DockPanel Margin="0,10,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="最长指令时长" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="MaxUtteranceValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="MaxUtteranceSlider" Minimum="3000" Maximum="30000" TickFrequency="1000" IsSnapToTickEnabled="True"
                                    ValueChanged="MaxUtteranceSlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="（单条指令最长录音时长，超时强制识别）" Margin="0,2,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 语音播报 ============ -->
            <TabItem Header="语音播报">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <TextBlock Text="汇报语言（所有语音回复强制使用；复杂操作只在执行结束后汇报结果）" Margin="0,0,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
                        <ComboBox x:Name="ReportLangBox" />
                        <TextBlock Text="播报方式" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="TtsModeBox" />
                        <TextBlock Text="云端音色（qwen3-tts-flash：Andre 沉稳磁性男声 / Cherry / Serena / Ethan 等）" Margin="0,8,0,2" FontSize="12" Foreground="#7A8699" />
                        <TextBox x:Name="TtsVoiceBox" />
                        <TextBlock Text="本地语速（仅本地模式）" Margin="0,10,0,0" FontSize="12" Foreground="#55606F" />
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="语速" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="TtsRateValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="TtsRateSlider" Minimum="-10" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="TtsRateSlider_OnValueChanged" />
                        </DockPanel>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="音量" Width="90" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="TtsVolumeValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="TtsVolumeSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="TtsVolumeSlider_OnValueChanged" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 界面与反馈 ============ -->
            <TabItem Header="界面与反馈">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <CheckBox x:Name="SelfVoiceFilterCheck" Content="播报回复时忽略麦克风（防止自己的声音误触打断）" Margin="0,0,0,6" FontSize="12" />
                        <CheckBox x:Name="EdgeGlowCheck" Content="被唤起时显示屏幕边缘光效（Siri 风格，窗口开关都显示）" Margin="0,6,0,6" FontSize="12" />

                        <TextBlock Text="对话浮层（窗口隐藏时桌面中下部透明显示对话）" FontWeight="Bold" FontSize="13" Foreground="#55606F" Margin="0,12,0,0" />
                        <CheckBox x:Name="OverlayCheck" Content="启用对话浮层" Margin="0,8,0,0" FontSize="12" />
                        <TextBlock Text="浮层文字字体" Margin="24,8,0,2" FontSize="12" Foreground="#7A8699" />
                        <ComboBox x:Name="OverlayFontBox" Margin="24,0,0,0" />
                        <TextBlock Text="浮层文字字号" Margin="24,10,0,0" FontSize="12" Foreground="#55606F" />
                        <DockPanel Margin="24,8,0,0">
                            <TextBlock DockPanel.Dock="Left" Text="字号" Width="60" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <TextBlock x:Name="OverlaySizeValue" DockPanel.Dock="Right" Width="46" TextAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="#55606F" />
                            <Slider x:Name="OverlaySizeSlider" Minimum="14" Maximum="48" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OverlaySizeSlider_OnValueChanged" />
                        </DockPanel>
                        <TextBlock Text="浮层文字颜色" Margin="24,10,0,2" FontSize="12" Foreground="#7A8699" />
                        <DockPanel Margin="24,0,0,0">
                            <ComboBox x:Name="OverlayColorBox" Width="140" />
                            <TextBox x:Name="OverlayColorText" Width="90" Margin="8,0,0,0" VerticalContentAlignment="Center" FontSize="12" />
                            <TextBlock Text="（支持 #RRGGBB 或预设）" VerticalAlignment="Center" Margin="8,0,0,0" FontSize="11" Foreground="#9AA5B1" />
                        </DockPanel>
                        <CheckBox x:Name="OverlayShadowCheck" Content="文字阴影（无背景下的可读性）" Margin="24,8,0,0" FontSize="12" />

                        <CheckBox x:Name="TrayCheck" Content="点击关闭时最小化到系统托盘" Margin="0,12,0,6" FontSize="12" />
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动（静默驻留托盘，不显示界面）" Margin="0,6,0,0" FontSize="12" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 助手人格 ============ -->
            <TabItem Header="助手人格">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <TextBlock Text="助手人格（注入系统提示词【人格】段，影响回复语气与风格）" FontWeight="Bold" FontSize="13" Foreground="#55606F" />
                        <TextBlock Text="默认是梁文峰人格（DeepSeek 创始人：低调沉稳、务实直接、冷幽默）。修改后保存，DSH 会自动优化你的描述并注入系统提示词，下次指令生效。留空或点「恢复默认」回到梁文峰人格。"
                                   Margin="0,8,0,8" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" LineHeight="20" />
                        <TextBox x:Name="PersonaBox" Height="180" AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontSize="12" FontFamily="Microsoft YaHei UI" />
                        <Button Content="恢复默认（梁文峰人格）" Width="160" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="RestoreDefaultPersona_OnClick" />
                        <TextBlock Text="💡 提示：可以写任何风格，比如“毒舌吐槽型”“温柔体贴型”“学术严谨型”，DSH 会优化成可执行的人格描述。"
                                   Margin="0,10,0,0" FontSize="11" Foreground="#9AA5B1" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ 软件管理 ============ -->
            <TabItem Header="软件管理">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8,12,8,12">
                        <TextBlock Text="应用别名（每行：名称=路径或链接，用于找不到程序时兜底，如 战神5=steam://rungameid/2322010）" Margin="0,0,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
                        <TextBox x:Name="AliasesBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" />
                        <TextBlock Text="Git 项目目录（语音「推送到GitHub」时在此目录执行 git 提交推送）" Margin="0,10,0,2" FontSize="12" Foreground="#7A8699" TextWrapping="Wrap" />
                        <TextBox x:Name="GitPathBox" FontSize="12" />
                        <DockPanel Margin="0,12,0,0">
                            <Button Content="重新扫描已装软件" Width="140" HorizontalAlignment="Left" Click="RescanSoftwareButton_OnClick" />
                            <TextBlock x:Name="InventoryInfo" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11" Foreground="#7A8699" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
